# PostgreSQL 16 (voir docker-compose.yml pour le développement local)
DATABASE_URL="postgresql://school:school@127.0.0.1:5433/school?schema=public"

# Secret JWT / session - Générer avec: openssl rand -base64 32
AUTH_SECRET="changer-ceci-par-une-chaine-aleatoire-forte"

# Secret pour les crons - Générer avec: openssl rand -base64 32
# Utilisé par POST /api/cron/monthly-invoices et /api/cron/payment-reminders
CRON_SECRET="changer-ceci-par-une-autre-chaine-aleatoire-forte"
